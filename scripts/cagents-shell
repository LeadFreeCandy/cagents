#!/bin/bash
# cagents-shell — kept for muscle memory. The sidecar container is now the
# DEFAULT when you run cagents-feature in a plain terminal, so this is just
# an alias. (Classic full-terminal mode: cagents-feature --fullscreen.)
#
# Container keys, once inside:
#   ctrl+\   toggle between the list rail and the session pane (any terminal)
#   alt+q    jump to the list        alt+w   jump to the session
#            (alt keys need "Option as Meta" / "Esc+" in your terminal prefs)
#   click    either pane — the rail auto-collapses/expands with focus
#
# Esc is deliberately not bound: inside a session it's Claude's interrupt.
# To trade that away, run once:
#   tmux -L cagents-ui bind -n Escape select-pane -t :.0
exec "$HOME/.local/bin/cagents-feature" "$@"
